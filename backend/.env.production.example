# Production config for docker-compose.yml's `api` service. Copy this file to
# backend/.env.production on the server and fill it in -- it is gitignored,
# same as backend/.env. Never commit either.

APP_ENV=production
# Matches docker-compose.yml's db service: same network, service name "db" as
# the host. Password here MUST match the db service's POSTGRES_PASSWORD in
# docker-compose.yml -- they are two separate files with no automatic link.
DATABASE_URL=postgresql+psycopg://signal_lab:change-me-in-local-env@db:5432/signal_lab

# Generate a real one: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
# Never reuse the local-dev default here -- it's a well-known placeholder, and
# anyone who recognizes it can forge valid login tokens for every account.
JWT_SECRET=replace-with-a-freshly-generated-secret
JWT_EXPIRE_MINUTES=30

# Same-origin via the Caddy /api proxy means the frontend never actually needs
# a separate CORS origin in production -- this only matters if something else
# calls the API directly from a different origin. Set it to your real domain
# (or the server's IP) once you have one, as defense in depth.
CORS_ORIGINS=http://localhost:8080

# ICICI Direct Breeze API -- see README "Backend foundation" for how to get
# these. BREEZE_SESSION_TOKEN expires ~24h / at midnight: refreshing it means
# editing this file on the server and running `docker compose restart api`.
# Also: this server's IP is what you register as Breeze's "static IP" --
# whatever IP this VM has when you set up the Breeze app is the one that must
# stay stable (changeable only once/week on Breeze's side).
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

ALERT_POLL_SECONDS=60
# Off by default -- see backend/.env.example for what this does before
# turning it on here. Doubly worth being deliberate about in production,
# since it now runs unattended on a public server, not your laptop.
ALERTS_SCHEDULER_ENABLED=false
