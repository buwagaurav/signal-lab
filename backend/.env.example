APP_ENV=development
DATABASE_URL=sqlite:///./signal_lab.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:8080
# ICICI Direct Breeze API -- see README "Backend foundation" for how to get these.
# BREEZE_SESSION_TOKEN expires ~24h / at midnight and must be refreshed manually.
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
ALERT_POLL_SECONDS=60
# Off by default -- turns on the in-process scheduler that polls every enabled
# strategy against the licensed provider on ALERT_POLL_SECONDS. Only turn this
# on once you're ready for it to call Breeze unattended on a timer (counts
# against their 100/min, 5000/day limits).
ALERTS_SCHEDULER_ENABLED=false
